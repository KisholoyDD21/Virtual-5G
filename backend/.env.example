# Copy to .env and fill in real values before any non-local deployment.
# None of these defaults are safe for production.

ENVIRONMENT=development

# Local dev default is SQLite (no setup needed). For docker-compose / prod:
# DATABASE_URL=postgresql://virtual5g:virtual5g@postgres:5432/virtual5g
DATABASE_URL=sqlite:///./virtual5g.db

REDIS_URL=redis://localhost:6379/0

# Generate a real secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

SPEEDTEST_DOWNLOAD_URL=https://speed.cloudflare.com/__down
SPEEDTEST_UPLOAD_URL=https://speed.cloudflare.com/__up

TELEMETRY_ENABLED_BY_DEFAULT=false
